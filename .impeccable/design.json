      "css": ".ds-row{display:flex;align-items:flex-start;justify-content:space-between;gap:2rem;padding:1.5rem .5rem;border-bottom:1px solid var(--color-divider);border-radius:0;color:var(--color-primary);text-decoration:none;font-family:var(--font-inter);transition:background-color .15s}.ds-row-title{margin:0 0 1rem;font-size:2.25rem;line-height:2.5rem;font-weight:300;letter-spacing:-.025em;transition:color .15s}.ds-row-description{margin:0;max-width:42rem;color:var(--color-secondary);font-size:1rem;line-height:1.5}.ds-row-arrow{color:var(--color-subtle);transition:color .15s}.ds-row:hover{background:color-mix(in srgb,var(--color-accent) 4%,transparent)}.ds-row:hover .ds-row-title,.ds-row:hover .ds-row-arrow,.ds-row:focus-visible .ds-row-title{color:var(--color-accent)}.ds-row:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}@media(min-width:768px){.ds-row{padding:2rem .75rem}}"
