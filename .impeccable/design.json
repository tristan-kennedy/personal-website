      "css": ".ds-menu-surface{background:var(--color-accent);padding:1rem}.ds-theme-toggle{display:flex;align-items:center;gap:.5rem;background:transparent;border:0;border-radius:0;color:var(--color-white);font-family:var(--font-inter);font-size:.75rem;line-height:1rem;letter-spacing:.2rem;cursor:pointer;transition:transform .15s}.ds-theme-active{font-weight:700}.ds-theme-inactive{opacity:.7}.ds-theme-toggle:hover{transform:scale(1.05)}.ds-theme-toggle:active{transform:scale(.98)}.ds-theme-toggle:focus-visible{outline:2px solid currentColor;outline-offset:4px}"
