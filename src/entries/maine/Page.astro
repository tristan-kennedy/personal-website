        time="3:27 pm"
        note="A sailboat, from the plane."
        sizes={third}
        class="col-span-4 col-start-6 mt-[clamp(40px,10vw,200px)] phone:col-span-7 phone:col-start-3 phone:mt-0"
      />
      <Photo
        src={photo("forest-from-above")}
