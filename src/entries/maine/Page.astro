---
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import type { Entry } from "../../lib/entries";
import Day from "./components/Day.astro";
import Photo from "../../components/Photo.astro";
import Strip from "./components/Strip.astro";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("./assets/*.jpg", {
  eager: true,
});
const photo = (name: string) => photos[`./assets/${name}.jpg`].default;
const { title, date, keywords } = entry.data;

const wide = "(max-width: 700px) 100vw, 68vw";
const half = "(max-width: 700px) 100vw, 38vw";
const third = "(max-width: 700px) 100vw, 30vw";
const small = "(max-width: 700px) 80vw, 22vw";
---

<Layout
  title={title}
  description="Six days in and around Acadia in October, in photos: the coast, the gardens, Cadillac at sunrise, Schoodic in fog, and Jordan Pond."
>
  <article class="overflow-x-clip bg-[#1d2620] text-paper">
    <header class="grid min-h-dvh grid-cols-12 items-stretch">
      <div
        class="col-span-5 flex flex-col justify-between gap-16 px-(--gutter) pt-(--col-inset) pb-[clamp(40px,5vw,96px)] phone:col-span-12 phone:min-h-[70dvh]"
      >
        <p
          class="flex justify-between gap-6 font-mono text-[clamp(14px,1.1vw,18px)]/[2] text-paper/60"
        >
          <a
            class="text-paper link phone:inline-flex phone:min-h-11 phone:items-center"
            href="/index/"
          >
            $ cd ..
          </a>
          <span class="phone:hidden">
            <time datetime={date}>{date}</time>
            {` ${keywords.join(" ").toLowerCase()}`}
          </span>
        </p>
        <div>
          <h1
            class="font-serif text-[max(96px,calc(11*var(--vw)))]/[0.85] tracking-[-0.03em]"
          >
            Maine
          </h1>
          <p
            class="mt-[clamp(24px,3vw,48px)] max-w-[22em] font-serif text-[clamp(20px,1.7vw,30px)]/[1.3] text-balance"
          >
            Six days in and around Acadia, October 10 to 15, 2026, with Trinity,
            my mom, and my dad.
          </p>
          <p
            class="mt-6 font-mono text-[12px] tracking-[0.14em] text-[#f2b93b] uppercase"
          >
            100 photos, out of 435
          </p>
        </div>
      </div>
      <Photo
        src={photo("asticou-maple")}
        alt="An orange maple arching over the pond at Asticou Azalea Garden, red and gold shrubs reflected in the water."
        sizes="(max-width: 700px) 100vw, 58vw"
        eager
        quality={90}
        frame="h-dvh phone:h-[90vw]"
        class="col-span-7 phone:col-span-12"
      />
    </header>

    <Day
      id="saturday"
      number={1}
      weekday="Saturday"
      date="Oct 10"
      places={["the plane", "portland airport"]}
      class="bg-[#23262b]"
    >
      <Photo
        src={photo("plane-nap")}
