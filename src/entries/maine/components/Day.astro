---
interface Props {
  id: string;
  number: number;
  weekday: string;
  date: string;
  places: string[];
  class?: string;
}

const { id, number, weekday, date, places, class: className } = Astro.props;
---

<section
  aria-labelledby={id}
  class:list={["py-[clamp(88px,11vw,200px)] text-paper", className]}
>
  <div
    class="grid grid-cols-12 items-start gap-x-[clamp(16px,2vw,40px)] px-(--gutter)"
  >
    <header
      class="sticky top-[clamp(24px,4vw,64px)] col-span-3 phone:static phone:col-span-12 phone:mb-12"
    >
      <p
        class="font-mono text-[12px] tracking-[0.14em] text-[#f2b93b] uppercase"
      >
        Day {number} · {date}
      </p>
      <h2
        id={id}
        class="mt-3 font-serif text-[clamp(40px,3.6vw,72px)]/[0.95] tracking-[-0.02em]"
      >
        {weekday}
      </h2>
      <ul
        class="mt-6 space-y-1 font-mono text-[clamp(13px,0.95vw,15px)]/[1.6] text-paper/70 lowercase"
      >
        {places.map((place) => <li>{place}</li>)}
      </ul>
    </header>
    <div
      class="col-span-9 grid grid-cols-9 items-start gap-x-[clamp(12px,1.6vw,28px)] gap-y-[clamp(48px,6vw,112px)] phone:col-span-12 phone:gap-y-12"
    >
      <slot />
    </div>
  </div>
  <slot name="after" />
</section>
