---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import PageRevealEffects from "../components/PageRevealEffects.astro";
import ScrollToTop from "../components/menu/ScrollToTop";
import Navigation from "../components/Navigation.astro";
import "../global.css";
interface Props {
  title: string;
  bodyClass?: string;
  showChrome?: boolean;
}

const { title, bodyClass = "", showChrome = true, ...bodyProps } = Astro.props;
---

<html lang="en" data-motion="on">
  <Head title={title} />
  <body
    {...bodyProps}
    class={`${bodyClass} mx-auto flex flex-col scroll-smooth bg-bg px-8 font-inter text-primary transition-colors`}
  >
    <ScrollToTop client:load />
    {showChrome && <Navigation />}
    <main>
      <slot />
    </main>
    {showChrome && <Footer />}
    <PageRevealEffects />
  </body>
</html>
