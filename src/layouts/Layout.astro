---
import Footer from "../components/Footer.astro";
import "@fontsource/barlow-condensed/800.css";
import "@fontsource/marcellus/400.css";
import "@fontsource/mrs-saint-delafield/400.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  home?: boolean;
}

const {
  title,
  description = "Projects, writing, trips, and other things I’ve spent time on. A personal archive by Tristan Kennedy.",
  home = false,
} = Astro.props;
const pageTitle = home ? title : `${title} — Tristan Kennedy`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#292824" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      html[data-sweep]::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: #292824;
      }
      html[data-sweep] * {
        animation-play-state: paused !important;
      }
    </style>
    <script is:inline>
      try {
        const returning =
          performance.getEntriesByType("navigation")[0]?.type ===
          "back_forward";
        const sweep = sessionStorage.getItem("sweep") || (returning && "-1");
        if (sweep && !matchMedia("(prefers-reduced-motion: reduce)").matches)
          document.documentElement.dataset.sweep = sweep;
      } catch {}
    </script>
  </head>
  <body>
    <a
      class="fixed top-2 left-4 z-100 -translate-y-[160%] bg-paper px-[18px] py-3 text-charcoal focus:translate-y-0"
      href="#main">Skip to content</a
    >
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import { mountSweep } from "../lib/sweep";
      mountSweep();
    </script>
  </body>
</html>
