---
interface Props {
  href: string;
  index: number | string;
  title: string;
  description: string;
  date: string;
  meta?: string | string[];
  metaType?: "text" | "tags";
  class?: string;
}

const {
  href,
  index,
  title,
  description,
  date,
  meta,
  metaType = "text",
  class: className = "",
} = Astro.props;

const displayIndex =
  typeof index === "number" ? String(index).padStart(2, "0") : index;
const metaItems = Array.isArray(meta) ? meta : meta ? [meta] : [];
---

<a
  href={href}
  class={`group block border-b border-divider px-2 py-6 transition-colors hover:bg-accent/4 md:px-3 md:py-8 ${className}`}
>
  <div class="flex flex-col gap-5 md:flex-row md:items-start md:gap-8">
    <div
      class="hidden shrink-0 text-xs tracking-[0.2rem] text-subtle md:block md:w-12"
    >
      {displayIndex}
    </div>

    <div class="max-w-[44rem]">
      <h2
        class="mb-4 text-4xl font-light tracking-tight text-primary transition-colors group-hover:text-accent"
      >
        {title}
      </h2>
      <p class="max-w-[42rem] text-secondary">{description}</p>

      {
        metaItems.length > 0 && metaType === "tags" && (
          <div class="mt-5 hidden flex-wrap gap-x-4 gap-y-2 text-xs tracking-[0.18rem] text-subtle uppercase md:flex">
            {metaItems.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        )
      }

      {
        metaItems.length > 0 && metaType === "text" && (
          <p class="mt-5 hidden text-xs tracking-[0.18rem] text-subtle uppercase md:block">
            {metaItems[0]}
          </p>
        )
      }
    </div>

    <div
      class="flex items-end justify-between gap-4 md:ml-auto md:min-w-36 md:flex-col md:items-end"
    >
      <span class="text-xs tracking-[0.2rem] text-subtle uppercase">{date}</span
      >
      <span
        class="text-xs tracking-[0.2rem] text-subtle transition-colors group-hover:text-accent"
        aria-hidden="true"
      >
        &rarr;
      </span>
    </div>
  </div>
</a>
