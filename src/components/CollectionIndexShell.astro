---
interface Props {
  title: string;
  backHref: string;
  backLabel: string;
  count: number;
  countLabel: string;
  mobileTitleLines?: string[];
}

const {
  title,
  backHref,
  backLabel,
  count,
  countLabel,
  mobileTitleLines = [title],
} = Astro.props;
const displayCount = String(count).padStart(2, "0");
---

<section class="min-h-[calc(100svh-64px)] py-8 md:py-10">
  <header class="pb-8 md:pb-12">
    <div class="mb-10 flex items-center justify-between gap-6 md:mb-14">
      <a
        href={backHref}
        class="flex items-center gap-2 text-xs tracking-[0.2rem] text-subtle transition-colors md:hover:text-accent"
        data-reveal="page-back"
        data-reveal-direction="left"
        data-reveal-trigger="load"
        data-reveal-delay="0.08"
      >
        <span aria-hidden="true">&larr;</span>
        <span>{backLabel}</span>
      </a>
    </div>

    <div
      class="flex items-end justify-between gap-8 border-t border-divider pt-8"
      data-reveal="page-title"
      data-reveal-trigger="load"
      data-reveal-delay="0.16"
    >
      <h1 class="font-black uppercase" aria-label={title}>
        <span
          class="flex flex-col text-[clamp(4rem,20vw,5.5rem)] leading-[0.82] tracking-[-0.045em] md:hidden"
          aria-hidden="true"
        >
          {mobileTitleLines.map((line) => <span class="block">{line}</span>)}
        </span>
        <span
          class="hidden text-[clamp(3.75rem,11vw,10rem)] leading-[0.9] tracking-[-0.02em] md:block"
          aria-hidden="true"
        >
          {title}
        </span>
      </h1>

      <div class="hidden shrink-0 text-right lg:block">
        <p class="text-4xl leading-none font-black text-accent">
          {displayCount}
        </p>
        <p class="mt-3 text-xs tracking-[0.2rem] text-subtle">{countLabel}</p>
      </div>
    </div>
  </header>

  <div
    class="mt-6 border-t border-divider pb-64"
    data-reveal-group
    data-reveal-stagger="0.06"
  >
    <slot />
  </div>
</section>
