---
import type { Entry } from "../../lib/entries";
import Recents from "./Recents.astro";

interface Props {
  picks: Entry[];
  recent: Entry[];
}

const { picks, recent } = Astro.props;
const fills = [0.74, 0.66, 0.72, 0.68];
---

<section
  class="overflow-clip border-t border-rule bg-charcoal py-(--section-space) text-paper"
  data-reveal
  id="from-the-index"
  aria-labelledby="selected-title"
>
  <div
    class="mb-[clamp(32px,4vw,64px)] flex items-center gap-[clamp(16px,2vw,32px)] pr-(--gutter) pl-0"
  >
    <span
      class="h-[clamp(6px,0.8vw,14px)] min-w-12 flex-auto bg-current reveal motion-safe:origin-left unrevealed:scale-x-0"
      aria-hidden="true"></span>
    <h2
      id="selected-title"
      class="flex-none font-display text-[clamp(76px,12vw,288px)]/[0.8] font-extrabold tracking-[-0.03em] uppercase reveal [--delay:0.15s] phone:text-[12.5vw] unrevealed:translate-x-8 unrevealed:opacity-0"
    >
      Favorites.
    </h2>
  </div>
  <ol class="@container px-(--gutter) py-0">
    {
      picks.map((entry, i) => {
        const even = i % 2 === 1;
        return (
          <li
            class:list={[
              "reveal [--delay:var(--row)] not-first:mt-[clamp(10px,1.6vw,36px)] unrevealed:opacity-0",
              even ? "unrevealed:translate-x-12" : "unrevealed:-translate-x-12",
            ]}
            style={`--n: ${entry.data.title.length}; --fill: ${fills[i]}; --row: ${0.2 + i * 0.1}s`}
          >
            <a
              class:list={[
                "group flex items-start whitespace-nowrap [transition:color_0.3s_ease] phone:flex-wrap",
                "in-[ol:has(a:hover,a:focus-visible)]:not-[:hover,:focus-visible]:text-dim",
                even
                  ? "-ml-(--gutter) flex-row-reverse font-serif text-(length:--fs)/[0.95] tracking-[-0.03em] [--fs:calc(var(--fill)*216cqi/var(--n))]"
                  : "-mr-(--gutter) font-display text-(length:--fs)/[0.84] font-extrabold tracking-[-0.035em] uppercase [--fs:calc(var(--fill)*240cqi/var(--n))]",
              ]}
              href={entry.url}
            >
              <span class="relative flex-none">
                <span
                  class="dither-text absolute top-0 left-0 [translate:0.05em_0.06em] reveal [--delay:calc(var(--row)+0.5s)] [transition:translate_0.45s_var(--ease-soft)] group-hover:[translate:0.12em_0.14em] group-focus-visible:[translate:0.12em_0.14em] unrevealed:[translate:0_0]"
                  aria-hidden="true"
                >
                  {entry.data.title}
                </span>
                <span class="relative z-1">{entry.data.title}</span>
              </span>
              <span
                class:list={[
                  "relative z-1 flex flex-none flex-col gap-0.5 font-sans text-[clamp(11px,0.8vw,14px)]/[1.3] font-normal tracking-[0.08em] text-muted uppercase reveal [--delay:calc(var(--row)+0.8s)] unrevealed:opacity-0",
                  "phone:order-1 phone:m-0 phone:mt-1.5 phone:w-full phone:flex-row phone:gap-x-2.5 phone:gap-y-0",
                  even
                    ? "mt-[calc(var(--fs)*0.16)] mr-[clamp(12px,1.2vw,24px)] items-end text-right phone:justify-end"
                    : "mt-[calc(var(--fs)*0.1)] ml-[clamp(12px,1.2vw,24px)]",
                ]}
              >
                {entry.data.keywords.map((keyword) => (
                  <span>{keyword}</span>
                ))}
              </span>
              <span
                class:list={[
                  "dither-text flex flex-none gap-[0.3em] opacity-60 reveal [--delay:calc(var(--row)+0.6s)] [transition:translate_0.6s_var(--ease-soft)] unrevealed:opacity-0 [&>span]:flex-none",
                  "phone:min-w-0 phone:flex-[1_1_0] phone:overflow-hidden phone:mask-none",
                  even
                    ? "flex-row-reverse mask-[linear-gradient(to_left,#000,transparent_70%)] pr-[0.3em] group-hover:[translate:-0.3em_0] group-focus-visible:[translate:-0.3em_0] phone:flex-row phone:justify-end unrevealed:[translate:0.6em_0]"
                    : "mask-[linear-gradient(to_right,#000,transparent_70%)] pl-[0.3em] group-hover:[translate:0.3em_0] group-focus-visible:[translate:0.3em_0] unrevealed:[translate:-0.6em_0]",
                ]}
                aria-hidden="true"
              >
                {Array.from({ length: 3 }, () => (
                  <span>{entry.data.title}</span>
                ))}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
  <Recents entries={recent} />
</section>
