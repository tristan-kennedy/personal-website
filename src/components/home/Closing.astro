---
import DitherApple from "./DitherApple.astro";

const source =
  "https://www.victorianweb.org/authors/pater/renaissance/conclusion.html";
const mark =
  "reveal relative z-2 col-[1/5] justify-self-center bg-paper px-3 font-mono text-[13px]/none tracking-[0.14em] whitespace-nowrap text-ink-muted uppercase [--delay:1.1s] unrevealed:opacity-0";
---

<section
  class="relative z-1 overflow-x-clip px-(--gutter) py-(--section-space) paper [--apple:min(58vw,1100px)] [--box-line:clamp(2px,0.2vw,3px)] phone:[--apple:64vw]"
  data-reveal
  id="quote"
  aria-label="A quote by Walter Pater"
>
  <figure
    class="relative grid grid-cols-4 grid-rows-[1fr_auto_auto_1fr] before:col-[1/5] before:row-[1/5] before:border-(length:--box-line) before:border-charcoal before:content-[''] ready:before:[transition:var(--reveal-transition)] unrevealed:before:opacity-0"
  >
    <DitherApple />
    <blockquote
      class="relative z-2 col-[2/5] row-[2] px-[clamp(20px,3vw,72px)] pt-[clamp(32px,4vw,96px)] pb-0 text-right font-serif text-[clamp(20px,3.6vw,64px)] tracking-[-0.025em] reveal [--delay:0.45s] phone:col-[1/5] phone:ml-[22%] phone:px-4 phone:pt-[22px] unrevealed:translate-x-12 unrevealed:opacity-0"
      cite={source}
    >
      <p
        class="ml-auto max-w-[28ch] leading-[1.25] text-pretty paper-outline-[0.14em] phone:text-balance"
      >
        “Not the fruit of experience, but <em
          class="font-display text-[1.14em]/none font-extrabold tracking-[-0.01em] uppercase not-italic"
          >experience itself</em
        >, is the end. A counted number of pulses only is given to us of a
        variegated, dramatic life.”
      </p>
    </blockquote>
    <figcaption
      class="relative z-2 col-[2/5] row-[3] flex items-baseline gap-2.5 justify-self-end px-[clamp(20px,3vw,72px)] pt-[clamp(8px,1vw,16px)] pb-[clamp(32px,4vw,96px)] text-right text-[13px]/[1.45] text-muted reveal [--delay:0.65s] phone:col-[1/5] phone:ml-auto phone:block phone:max-w-[56%] phone:px-4 phone:pt-1.5 phone:pb-6 phone:leading-[1.6] unrevealed:translate-x-12 unrevealed:opacity-0"
    >
      <span class="phone:hidden" aria-hidden="true">—</span>
      <span>
        <a
          class="inline-block min-h-11 py-2.5 link phone:inline phone:min-h-0 phone:p-0"
          href={source}>Walter Pater</a
        >, <cite class="not-italic">The Renaissance</cite> (1873), Conclusion
      </span>
    </figcaption>
    <span
      class:list={[
        mark,
        "row-[1] [translate:0_calc(-50%-var(--box-line)/2)] self-start",
      ]}
      aria-hidden="true">What is the end</span
    >
    <span
      class:list={[
        mark,
        "row-[4] [translate:0_calc(50%+var(--box-line)/2)] rotate-180 self-end",
      ]}
      aria-hidden="true">Who am I</span
    >
  </figure>
</section>
