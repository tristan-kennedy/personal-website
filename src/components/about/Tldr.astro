---
import SectionHeading from "./SectionHeading.astro";
import { opinions, questions } from "../../lib/site";

let noted = 0;
const spacing = opinions.length / questions.length;
const sprawl = opinions
  .flatMap((opinion, i) => {
    const question = questions[Math.floor((i + 1) / spacing) - 1];
    const asks = Math.floor((i + 1) / spacing) > Math.floor(i / spacing);
    return [
      { ...opinion, sure: true },
      ...(asks && question ? [{ ...question, sure: false }] : []),
    ];
  })
  .map((item) => ({ ...item, mark: item.note ? ++noted : undefined }));
const notes = sprawl.filter((item) => item.note);
const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const markup = ({ text, mark }: { text: string; mark?: number }) =>
  escape(text) +
  (mark
    ? `<sup class="ml-[0.1em] font-mono text-[0.65em] text-ink-muted"><a class="hover:underline focus-visible:underline" href="#tldr-note-${mark}" aria-label="Note ${mark}">${mark}</a></sup>`
    : "") +
  " ";
---

<section
  class="grid grid-cols-4 grid-rows-[auto_1fr] gap-y-8 px-(--gutter) pt-[clamp(40px,5vw,88px)] pb-(--section-space) paper phone:grid-cols-1 phone:grid-rows-none"
  data-reveal
  aria-labelledby="tldr-title"
>
  <SectionHeading
    id="tldr-title"
    class="col-[1/3] row-1 pr-(--col-inset) phone:col-1 phone:pr-0 unrevealed:-translate-x-8"
  >
    TL;DR.
  </SectionHeading>
  <p
    class="col-[3/5] row-[1/3] max-w-[44ch] pl-(--col-inset) text-body/[1.65] text-pretty text-ink-muted reveal [--delay:0.15s] phone:col-1 phone:row-auto phone:pl-0 phone:text-[17px] unrevealed:opacity-0"
  >
    {
      sprawl.map((item) => (
        <span class:list={[item.sure && "text-charcoal"]}>
          <Fragment set:html={markup(item)} />
        </span>
      ))
    }
  </p>
  {
    notes.length > 0 && (
      <ol
        class="col-[1/3] row-2 grid max-w-[40ch] gap-y-3 self-end pr-(--col-inset) text-[15px]/[1.5] text-ink-muted reveal [--delay:0.3s] phone:col-1 phone:row-auto phone:pr-0 unrevealed:opacity-0"
        aria-label="Notes"
      >
        {notes.map((item) => (
          <li
            id={`tldr-note-${item.mark}`}
            class="grid grid-cols-[3ch_minmax(0,1fr)]"
          >
            <span class="font-mono text-[13px]">{item.mark}</span>
            <span>{item.note}</span>
          </li>
        ))}
      </ol>
    )
  }
</section>
