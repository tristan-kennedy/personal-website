---
import type { Entry } from "../../lib/entries";
import type { Place, Tier } from "../../lib/scatter";

interface Props {
  entry: Entry;
  tier: Tier;
  place: Place;
}

const { entry, tier, place } = Astro.props;
const { date, keywords } = entry.data;
const onInk =
  "charcoal-halo [transition:color_0.3s_ease] in-data-active:text-paper";
const small =
  "pointer-events-auto ml-3 font-mono font-normal tracking-normal whitespace-nowrap text-muted normal-case";
---

{
  tier === "poster" && (
    <span
      class:list={[
        "pointer-events-auto relative top-[calc(var(--fs)*0.1)] z-1 ml-[clamp(12px,1.2vw,24px)] inline-flex flex-col gap-0.5 text-left align-top font-mono text-[13px]/[1.45] font-normal tracking-normal text-muted normal-case",
        "phone:absolute phone:top-(--gap) phone:bottom-(--gap) phone:m-0 phone:w-max phone:rotate-180 phone:flex-row phone:flex-wrap phone:content-start phone:justify-end phone:gap-x-3 phone:gap-y-1 phone:[writing-mode:vertical-rl]",
        place.flipped ? "phone:left-0" : "phone:right-0",
        onInk,
      ]}
    >
      <time datetime={date}>{date}</time>
      {keywords.map((keyword) => (
        <span>{keyword.toLowerCase()}</span>
      ))}
    </span>
  )
}
{
  tier === "title" && (
    <span class:list={[small, "text-[13px]/none", onInk]}>
      <time datetime={date}>{date}</time>
      {keywords.length > 0 && (
        <span class="phone:hidden"> {keywords.join(" ").toLowerCase()}</span>
      )}
    </span>
  )
}
{
  tier === "scrap" && (
    <time class:list={[small, "text-[11px]/none", onInk]} datetime={date}>
      {date}
    </time>
  )
}
