---
import type { Entry } from "../../lib/entries";

interface Props {
  entry: Entry;
  slide?: string;
  right: boolean;
}

const { entry, slide, right } = Astro.props;
const { date, keywords } = entry.data;
---

<span
  class:list={[
    right ? "deck:justify-end deck:self-end" : "deck:self-start",
    "pointer-events-auto relative top-[calc(var(--fs)*0.1)] z-1 ml-[clamp(12px,1.2vw,24px)] inline-flex flex-col gap-0.5 text-left align-top font-mono text-[13px]/[1.45] font-normal tracking-normal text-muted normal-case [transition:color_0.3s_ease] charcoal-halo in-data-active:text-paper deck:static deck:mt-[clamp(14px,0.3em,28px)] deck:ml-0 deck:flex deck:flex-row deck:gap-3",
  ]}
>
  {slide && <span>{slide}</span>}
  <time datetime={date}>{date}</time>
  {
    keywords.map((keyword, i) => (
      <span class:list={[i > 0 && "deck:hidden"]}>{keyword.toLowerCase()}</span>
    ))
  }
</span>
