---
import type { Entry } from "../../lib/entries";
import type { Place, Tier } from "../../lib/scatter";
import EntryMeta from "./EntryMeta.astro";

interface Props {
  entry: Entry;
  tier: Tier;
  place: Place;
}

const { entry, tier, place } = Astro.props;
const { title, colour } = entry.data;
const style = [
  "--size: " + place.size + "cqi",
  "--left: " + place.left + "cqi",
  "--right: " + place.right + "cqi",
  "--phone-size: " + place.phone.size + "cqi",
  "--phone-left: " + place.phone.left + "cqi",
  "--phone-right: " + place.phone.right + "cqi",
  "--air: " + place.phone.air,
  "--ink: " + (colour ?? "var(--color-dim)"),
].join("; ");
const face = place.serif
  ? "font-serif tracking-[-0.03em]"
  : "font-display font-extrabold tracking-[-0.035em] uppercase";
const poster = tier === "poster";
---

<li
  class="relative [@media(hover:hover)]:pointer-events-none"
  style={style}
  data-row
  data-reveal={tier === "poster" ? "" : undefined}
>
  <a
    class:list={[
      "group relative z-1 block py-(--gap) text-(length:--fs) text-balance [--fs:max(18px,var(--size))] [--gap:clamp(20px,calc(var(--fs)*0.36),76px)] phone:[--fs:max(18px,var(--phone-size))] phone:[--gap:calc(clamp(20px,calc(var(--fs)*0.36),76px)*var(--air))]",
      face,
      "pr-(--right) pl-(--left) phone:pr-(--phone-right) phone:pl-(--phone-left)",
      place.alignRight ? "text-right" : "text-left",
      poster
        ? "leading-[0.92] reveal unrevealed:opacity-0"
        : "leading-[1.04]",
      poster &&
        (place.alignRight
          ? "unrevealed:translate-x-12"
          : "unrevealed:-translate-x-12"),
      tier === "scrap" && place.quiet && "text-muted",
    ]}
    href={entry.url}
    data-colour={colour}
  >
    <span
      class="pointer-events-none absolute inset-0 [translate:0.05em_0.06em] [padding:inherit] [--delay:0s] [transition:translate_0.7s_var(--ease-soft)_var(--delay),transform_0.45s_var(--ease-soft),--color-dim_0.3s_ease] in-data-active:[--color-dim:var(--ink)] motion-safe:in-data-active:[transform:translate(0.07em,0.08em)] unrevealed:[translate:0_0] revealing:[--delay:0.3s]"
      aria-hidden="true"
    >
      <span class="dither-text">{title}</span>
      <span class="invisible"
        ><EntryMeta entry={entry} tier={tier} place={place} /></span
      >
    </span>
    <h2
      class="pointer-events-auto relative z-1 inline font-[inherit] text-[length:inherit]/[inherit] tracking-[inherit] [-webkit-text-stroke:0.05em_transparent] [paint-order:stroke_fill] [transition:color_0.3s_ease,-webkit-text-stroke-color_0.3s_ease] in-data-dimmed:[-webkit-text-stroke-color:var(--color-charcoal)] in-data-dimmed:not-in-data-active:text-(--dimmed)"
      data-title
    >
      {title}
    </h2>
    <EntryMeta entry={entry} tier={tier} place={place} />
  </a>
</li>
