<div
  class="sticky bottom-0 z-10 border-t border-rule bg-charcoal pr-[max(var(--gutter),env(safe-area-inset-right))] pb-[env(safe-area-inset-bottom)] pl-[max(var(--gutter),env(safe-area-inset-left))] font-mono text-[14px] text-muted"
  data-bar
  hidden
>
  <div class="flex items-center gap-x-[clamp(12px,2vw,32px)]">
    <label
      class="flex min-h-11 min-w-0 flex-auto cursor-text items-center gap-[1ch]"
    >
      <span class="flex-none text-paper" aria-hidden="true">$ grep</span>
      <span class="sr-only">Search the index</span>
      <span class="flex min-w-0 flex-auto items-center gap-[1ch]">
        <span
          class="h-[1.1em] w-[0.6em] flex-none bg-paper in-[span:has(input:focus)]:hidden in-[span:has(input:not(:placeholder-shown))]:hidden motion-safe:animate-blink"
          aria-hidden="true"></span>
        <input
          class="w-full min-w-0 bg-transparent text-[14px] text-paper caret-paper outline-none placeholder:text-muted phone:text-[16px]"
          type="search"
          placeholder="search titles, tags, dates"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          data-search-input
        />
      </span>
    </label>
    <p class="flex-none empty:hidden" role="status" data-count></p>
    <button
      class="inline-flex min-h-11 flex-none cursor-pointer items-center underline underline-offset-[0.2em] hover:decoration-2 focus-visible:decoration-2"
      type="button"
      data-random
    >
      random
    </button>
  </div>
</div>
