---
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  note?: string;
  nav: { href: string; label: string };
}

const { title, note, nav } = Astro.props;
---

<Layout title={title}>
  <div class="px-(--gutter) pb-20 paper">
    <nav
      class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-6 text-[15px] [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center [&_a]:gap-3 [&_a]:underline"
      aria-label="Site"
    >
      <a href="/">Tristan Kennedy</a><a href={nav.href}>{nav.label}</a>
    </nav>
    <header
      class="flex flex-wrap items-baseline justify-between gap-x-12 gap-y-5 pt-10 pb-18 phone:block phone:pt-8 phone:pb-12"
    >
      <h1
        class="font-display text-[clamp(96px,16vw,280px)]/[0.95] font-extrabold tracking-[-0.03em]"
      >
        {title}<span class="font-serif font-normal">.</span>
      </h1>
      {
        note && (
          <p class="font-serif text-[max(20px,1.6vw)] phone:mt-6">{note}</p>
        )
      }
    </header>
    <slot />
  </div>
</Layout>
