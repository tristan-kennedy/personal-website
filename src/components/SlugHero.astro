---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { LuSquareArrowOutUpRight } from "react-icons/lu";

interface Props {
  title: string;
  image: ImageMetadata;
  description: string;
  backHref: string;
  backLabel: string;
  typeLabel: string;
  date: string;
  metaLabel: string;
  metaValue: string;
  linkHref?: string;
}

const {
  title,
  image,
  description,
  backHref,
  backLabel,
  typeLabel,
  date,
  metaLabel,
  metaValue,
  linkHref,
} = Astro.props;
---

<section class="mb-10 md:mb-12">
  <div class="relative -mx-8 min-h-[calc(100dvh-64px)] overflow-hidden">
    <Image
      src={image}
      alt={`${title} cover`}
      class="absolute inset-0 h-full w-full object-cover"
    />

    <div
      class="absolute inset-0 bg-linear-to-b from-white/18 via-white/0 to-black/72 dark:from-black/12 dark:via-black/24 dark:to-black/88"
    >
    </div>

    <div class="relative flex min-h-[calc(100dvh-64px)] flex-col px-8 py-8">
      <a
        href={backHref}
        class="h2 inline-flex items-center gap-2 self-start text-white/78 transition-colors hover:text-white"
      >
        <span aria-hidden="true">&larr;</span>
        <span>{backLabel}</span>
      </a>

      <div class="mt-auto max-w-[72rem] pb-2 md:pb-4">
        <h1 class="display-slug max-w-[14ch] font-black text-white">{title}</h1>
      </div>
    </div>
  </div>

  <div
    class="-mx-8 border-t border-b border-divider bg-bg md:grid md:grid-cols-3"
  >
    <div class="border-b border-divider px-8 py-5 md:border-r md:border-b-0">
      <p class="h2 text-subtle">TYPE</p>
      <div class="mt-3 flex items-center gap-3">
        <span class="text-sm text-primary md:text-base">{typeLabel}</span>
        {
          linkHref && (
            <a
              href={linkHref}
              target="_blank"
              rel="noreferrer"
              class="text-subtle transition-colors hover:text-accent"
              aria-label={`Open external link for ${title}`}
            >
              <LuSquareArrowOutUpRight className="size-4" />
            </a>
          )
        }
      </div>
    </div>

    <div class="border-b border-divider px-8 py-5 md:border-r md:border-b-0">
      <p class="h2 text-subtle">DATE</p>
      <p class="mt-3 text-sm text-primary md:text-base">{date}</p>
    </div>

    <div class="px-8 py-5">
      <p class="h2 text-subtle">{metaLabel}</p>
      <p class="mt-3 text-sm text-primary md:text-base">{metaValue}</p>
    </div>
  </div>

  <div
    class="mx-auto max-w-[720px] border-b border-divider bg-bg py-10 md:py-12"
  >
    <div class="mb-8 flex items-center gap-3">
      <span class="h-0.5 w-5 bg-accent" aria-hidden="true"></span>
      <p class="h2 text-subtle">OVERVIEW</p>
    </div>
    <p class="leading-8 text-secondary">{description}</p>
  </div>
</section>
