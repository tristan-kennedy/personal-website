---
import Layout from "../layouts/Layout.astro";
import Reveal from "../components/Reveal.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Favorites from "../components/home/Favorites.astro";
import Closing from "../components/home/Closing.astro";
import { getEntries } from "../lib/entries";

const entries = await getEntries();
const latest = entries[0];
const picks = entries
  .filter((entry) => entry.id !== latest?.id)
  .sort((a, b) => (a.data.featured ?? Infinity) - (b.data.featured ?? Infinity))
  .slice(0, 4);
---

<Layout title="Tristan Kennedy" home>
  <Reveal />
  <Hero />
  <About />
  <Favorites picks={picks} recent={entries.slice(0, 3)} />
  <Closing />
</Layout>
