---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SelectableRow from "../components/SelectableRow.astro";
import Tooltip from "../components/Tooltip";
import { getProjects } from "../lib/content/projects";
import { getPosts } from "../lib/content/posts";
import { getExperiments } from "../lib/content/experiments";

const heroNavItems = [
  { href: "#about", index: "01/", label: "ABOUT ME" },
  { href: "#projects", index: "02/", label: "PROJECTS" },
  { href: "#posts", index: "03/", label: "POSTS" },
  { href: "#experiments", index: "04/", label: "EXPERIMENTS" },
  { href: "#contact", index: "05/", label: "CONTACT" },
];

const aboutExpertiseItems = [
  "JavaScript / TypeScript",
  "React / Astro / Node.js",
  "Python / Django / Flask",
  "SQL / NoSQL Databases",
  "RESTful APIs & GraphQL",
  "Cloud Services (AWS, Azure)",
  "CI/CD & DevOps",
];

const contactItems = [
  {
    label: "GitHub",
    href: "https://github.com/tristan-kennedy",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/tristandkennedy/",
  },
  {
    label: "Letterboxd",
    href: "https://letterboxd.com/tdouglaskennedy/",
  },
  {
    label: "Resume",
    href: "/resume.pdf",
  },
];

const projects = await getProjects();
const posts = await getPosts();
const experiments = await getExperiments();

const featuredProjects = projects.slice(0, 2);
const featuredPosts = posts.slice(0, 1);
const featuredExperiments = experiments.slice(0, 3);
---

<Layout title="Tristan Kennedy">
  <div class="flex flex-col gap-16 md:gap-24 lg:gap-32">
    <section id="hero" class="flex min-h-[calc(100svh-64px)] flex-col py-8">
      <header
        class="flex items-center justify-end gap-2 text-right"
        data-reveal="hero-meta"
        data-reveal-trigger="load"
        data-reveal-delay="0.18"
      >
        <div>
          <h2>SOFTWARE ENGINEER</h2>
          <h3 class="text-sm text-subtle">Rogers, AR</h3>
        </div>
      </header>
      <div class="my-auto flex flex-col gap-6 py-6 md:gap-8">
        <h1
          class="font-black uppercase"
          aria-label="Tristan Kennedy"
          data-reveal="hero-title"
          data-reveal-trigger="load"
          data-reveal-delay="0.08"
        >
          <span
            class="flex flex-col text-[clamp(4.75rem,24vw,6.5rem)] leading-[0.8] tracking-[-0.05em] md:hidden"
            aria-hidden="true"
          >
            <span class="block">TRIS-</span>
            <span class="block">TAN</span>
            <span class="block">KENN-</span>
            <span class="block">EDY</span>
          </span>
          <span
            class="hidden text-[clamp(5.5rem,14.5vw,16rem)] leading-[0.9] tracking-[-0.02em] md:block"
            aria-hidden="true"
          >
            TRISTAN<br />KENNEDY
          </span>
        </h1>
      </div>
      <footer class="flex items-end justify-end md:justify-between">
        <nav
          class="hidden w-full lg:block lg:flex-1"
          data-reveal="hero-nav"
          data-reveal-direction="left"
          data-reveal-trigger="load"
          data-reveal-delay="0.34"
        >
          <ul class="flex flex-row gap-8">
            {
              heroNavItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group inline-flex flex-col items-center gap-1 text-center"
                  >
                    <span class="text-xs tracking-[0.2rem] text-subtle">
                      {item.index}
                    </span>
                    <span class="text-xs tracking-[0.2rem] text-secondary transition-colors group-hover:text-accent">
                      {item.label}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <h2
          class="shrink-0"
          data-reveal="hero-year"
          data-reveal-trigger="load"
          data-reveal-delay="0.24"
        >
          &copy; 2025
        </h2>
      </footer>
    </section>

    <section id="about">
      <div class="border-y border-divider py-6 md:py-8">
        <div class="mb-10 flex items-center gap-4" data-reveal="section-head">
          <span class="text-xs tracking-[0.2rem] text-subtle">01 /</span>
          <span class="text-xs tracking-[0.2rem] text-secondary">ABOUT ME</span>
        </div>

        <div class="flex flex-col items-start gap-12 md:flex-row md:gap-16">
          <div
            class="max-w-[32rem]"
            data-reveal="copy"
            data-reveal-direction="left"
          >
            <h1 class="mb-8 text-4xl font-light md:mb-10">
              I build products that are both functional and beautiful.
            </h1>
            <div class="max-w-prose space-y-6 text-secondary">
              <p>
                I'm a software engineer passionate about creating elegant
                solutions that matter. With a focus on full-stack development
                and creative engineering, I approach every project with
                technical precision and design thinking.
              </p>
              <p>
                This is still unresolved for me: whether the craft is in the
                code or in what the code makes possible. Probably both.
              </p>
            </div>
          </div>

          <div
            class="w-full max-w-[28rem]"
            data-reveal="copy"
            data-reveal-direction="left"
          >
            <h2 class="mb-6">EXPERTISE</h2>
            <ul
              class="list-none p-0"
              data-reveal-group
              data-reveal-stagger="0.06"
            >
              {
                aboutExpertiseItems.map((item) => (
                  <li
                    class="border-t border-divider py-3 first:border-t"
                    data-reveal="list-item"
                    data-reveal-direction="left"
                  >
                    <span class="text-sm text-secondary">{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="border-t border-divider pt-6 md:pt-8">
        <div
          class="mb-4 flex items-center justify-between gap-6 pb-6"
          data-reveal="section-head"
        >
          <div class="flex items-center gap-4">
            <span class="text-xs tracking-[0.2rem] text-subtle">02 /</span>
            <span class="text-xs tracking-[0.2rem] text-secondary"
              >PROJECTS</span
            >
          </div>
          <a
            href="/projects"
            class="text-xs tracking-[0.2rem] whitespace-nowrap text-subtle transition-colors hover:text-accent"
          >
            VIEW ALL <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div
          class="border-t border-divider"
          data-reveal-group
          data-reveal-stagger="0.08"
        >
          {
            featuredProjects.map((project, index) => (
              <div data-reveal="row" data-reveal-direction="left">
                <SelectableRow
                  href={project.url}
                  index={index + 1}
                  title={project.data.title}
                  description={project.data.description}
                  date={project.data.date}
                  meta={project.data.tech}
                  metaType="tags"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="posts">
      <div class="border-t border-divider pt-6 md:pt-8">
        <div
          class="mb-4 flex items-center justify-between gap-6 pb-6"
          data-reveal="section-head"
        >
          <div class="flex items-center gap-4">
            <span class="text-xs tracking-[0.2rem] text-subtle">03 /</span>
            <span class="text-xs tracking-[0.2rem] text-secondary">POSTS</span>
          </div>
          <a
            href="/posts"
            class="text-xs tracking-[0.2rem] whitespace-nowrap text-subtle transition-colors hover:text-accent"
          >
            ALL POSTS <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div
          class="border-t border-divider"
          data-reveal-group
          data-reveal-stagger="0.08"
        >
          {
            featuredPosts.map((post, index) => (
              <div data-reveal="row" data-reveal-direction="left">
                <SelectableRow
                  href={post.url}
                  index={index + 1}
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  meta={post.data.length}
                  metaType="text"
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="experiments">
      <div class="border-t border-divider pt-6 md:pt-8">
        <div
          class="mb-4 flex items-center justify-between gap-6 pb-6"
          data-reveal="section-head"
        >
          <div class="flex items-center gap-4">
            <span class="text-xs tracking-[0.2rem] text-subtle">04 /</span>
            <span class="text-xs tracking-[0.2rem] text-secondary"
              >EXPERIMENTS</span
            >
          </div>
          <a
            href="/experiments"
            class="text-xs tracking-[0.2rem] whitespace-nowrap text-subtle transition-colors hover:text-accent"
          >
            EXPLORE MORE <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div
          class="flex flex-col gap-10 border-t border-divider pt-6 xl:flex-row xl:gap-8 xl:pt-8"
          data-reveal-group
          data-reveal-stagger="0.1"
        >
          {
            featuredExperiments.map((experiment) => {
              return (
                <a
                  href={experiment.url}
                  class="group flex w-full flex-col gap-2 xl:flex-1"
                  data-reveal="card"
                  data-reveal-direction="left"
                >
                  <Tooltip client:load label={"READ MORE"} className="mb-4">
                    <div class="aspect-[1.25/1] overflow-hidden">
                      <Image
                        src={experiment.data.image}
                        alt={`${experiment.data.title} cover`}
                        loading="eager"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  </Tooltip>
                  <p class="font-light transition-colors group-hover:text-accent">
                    {experiment.data.title}
                  </p>
                  <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs tracking-[0.18rem] text-subtle uppercase">
                    {experiment.data.tech?.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <section id="contact" class="pb-24">
      <div class="border-t border-divider pt-6 md:pt-8">
        <div
          class="mb-6 flex items-center gap-4 pb-4 md:mb-8"
          data-reveal="section-head"
        >
          <span class="text-xs tracking-[0.2rem] text-subtle">05 /</span>
          <span class="text-xs tracking-[0.2rem] text-secondary">CONTACT</span>
        </div>

        <div class="border-t border-divider pt-8 md:pt-10">
          <div class="flex flex-col items-start gap-12 md:flex-row md:gap-16">
            <div
              class="max-w-[36rem]"
              data-reveal="copy"
              data-reveal-direction="left"
            >
              <h1 class="mb-8 text-4xl font-light md:mb-10">
                Let&apos;s build something thoughtful together.
              </h1>
              <p class="max-w-prose text-secondary">
                I am always open to new opportunities or interesting
                conversations. Email me at <a
                  href={`mailto:hello@tristan-kennedy.com`}
                  class="transition-colors hover:text-accent"
                >
                  hello@tristan-kennedy.com
                </a>or find me elsewhere here:
              </p>
            </div>

            <div
              class="w-full max-w-[28rem]"
              data-reveal="copy"
              data-reveal-direction="left"
            >
              <h2 class="mb-6">ELSEWHERE</h2>
              <ul
                class="list-none p-0"
                data-reveal-group
                data-reveal-stagger="0.06"
              >
                {
                  contactItems.map((item) => (
                    <li
                      class="border-t border-divider py-3 first:border-t"
                      data-reveal="list-item"
                      data-reveal-direction="left"
                    >
                      <a
                        href={item.href}
                        class="group flex items-center justify-between gap-4 text-sm text-secondary transition-colors hover:text-accent"
                        target="_blank"
                        rel="noreferrer"
                      >
                        <span>{item.label}</span>
                        <span
                          class="text-subtle transition-colors group-hover:text-accent"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
