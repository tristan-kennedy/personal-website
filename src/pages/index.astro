---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import Favorites from "../components/home/Favorites.astro";
import Closing from "../components/home/Closing.astro";
import { getEntries } from "../lib/entries";

const entries = await getEntries();
const latest = entries[0];
const picks = entries
  .filter((entry) => entry.id !== latest?.id)
  .sort((a, b) => (a.data.featured ?? Infinity) - (b.data.featured ?? Infinity))
  .slice(0, 4);
---

<Layout title="Tristan Kennedy" home>
  <script is:inline>
    if ("IntersectionObserver" in window) {
      document.documentElement.dataset.reveal = "ready";
      setTimeout(() => {
        if (window.__reveal) return;
        document
          .querySelectorAll("[data-reveal]")
          .forEach((section) => (section.dataset.revealed = "true"));
      }, 3000);
    }
  </script>
  <Hero />
  <About />
  <Favorites picks={picks} recent={entries.slice(0, 3)} />
  <Closing />
</Layout>

<script>
  import { revealOnScroll } from "../lib/reveal";
  revealOnScroll();
</script>
