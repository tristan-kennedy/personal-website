---
import CollectionIndexShell from "../../components/CollectionIndexShell.astro";
import SelectableRow from "../../components/SelectableRow.astro";
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/content/projects";

const projects = await getProjects();
---

<Layout title="Tristan Kennedy | Projects">
  <CollectionIndexShell
    title="Projects"
    mobileTitleLines={["PROJ-", "ECTS"]}
    backHref="/"
    backLabel="BACK"
    count={projects.length}
    countLabel="FINISHED WORKS"
  >
    {
      projects.map((project, index) => (
        <div data-reveal="row" data-reveal-direction="left">
          <SelectableRow
            href={project.url}
            index={index + 1}
            title={project.data.title}
            description={project.data.description}
            date={project.data.date}
            meta={project.data.tech}
            metaType="tags"
          />
        </div>
      ))
    }
  </CollectionIndexShell>
</Layout>
