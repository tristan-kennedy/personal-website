---
import EntryRow from "../../components/index/EntryRow.astro";
import DitherFrame from "../../components/DitherFrame.astro";
import Layout from "../../layouts/Layout.astro";
import Reveal from "../../components/Reveal.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getEntries } from "../../lib/entries";
import { scatter, tierAt } from "../../lib/scatter";

const entries = await getEntries();
const rows = entries.map((entry, i) => ({
  entry,
  tier: tierAt(i),
  place: scatter(entry, i, entries.length - 1 - i),
}));
---

<Layout title="Index">
  <Reveal />
  <div
    class="relative isolate overflow-clip bg-charcoal text-paper [--dimmed:var(--color-dim)] [@media(hover:none)]:[--dimmed:var(--muted)]"
    data-index
  >
    <div class="px-(--gutter)">
      <SiteNav link={{ href: "/about/", label: "About me" }} />
    </div>
    <header
      class="relative z-1 flex min-h-[calc(100svh-92px)] flex-col justify-end pb-[clamp(20px,3vw,48px)]"
      data-reveal
    >
      <div
        class="relative flex items-end gap-[clamp(16px,2vw,32px)] pl-(--gutter) phone:flex-col phone:items-stretch phone:gap-3 phone:pr-(--gutter)"
      >
        <h1
          class="flex-none font-display text-[min(23vw,552px)]/[0.8] font-extrabold tracking-[-0.035em] uppercase reveal phone:text-[calc((100vw-2*var(--gutter))/2.32)] unrevealed:-translate-x-8 unrevealed:opacity-0"
        >
          Index.
        </h1>
        <span
          class="mb-[0.4vw] h-[clamp(6px,0.8vw,14px)] min-w-12 flex-auto bg-current reveal motion-safe:origin-right phone:hidden unrevealed:scale-x-0"
          aria-hidden="true"></span>
        <figure
          class="pointer-events-none absolute right-0 bottom-[calc(0.4vw+clamp(6px,0.8vw,14px))] w-[min(calc(100%-var(--gutter)-min(23vw,552px)*2.3),calc((100svh-200px)*1.03))] reveal [--delay:0.2s] phone:relative phone:right-auto phone:bottom-auto phone:order-first phone:-mr-(--gutter) phone:w-[82vw] phone:self-end unrevealed:translate-x-16 unrevealed:opacity-0"
          aria-hidden="true"
          data-hand
        >
          <DitherFrame src="/dither/hand.png" size={240} height={232} />
        </figure>
      </div>
    </header>
    {
      entries.length === 0 && (
        <p class="px-(--gutter) pb-(--section-space)">
          Nothing here yet.{" "}
          <a class="link" href="/">
            Back home
          </a>
          .
        </p>
      )
    }
    <ol
      class="@container min-w-0 px-(--gutter) pt-(--section-space) pb-[calc(var(--section-space)*1.5)]"
    >
      {
        rows.map(({ entry, tier, place }) => (
          <EntryRow entry={entry} tier={tier} place={place} />
        ))
      }
    </ol>
  </div>
</Layout>

<script>
  import { mountPortrait } from "../../lib/dither/portrait";
  import { mountPeeks } from "../../lib/peek";

  mountPortrait("[data-hand]", "/dither/hand-source.png");

  const root = document.querySelector<HTMLElement>("[data-index]");
  if (root) mountPeeks(root);
</script>
