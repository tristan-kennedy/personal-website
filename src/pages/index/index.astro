---
import ArchivePage from "../../components/ArchivePage.astro";
import { getEntries, formatEntryDate } from "../../lib/entries";

const entries = await getEntries();
const years = [...new Set(entries.map((entry) => entry.data.date.slice(0, 4)))];
---

<ArchivePage
  title="Index"
  note="A growing index."
  nav={{ href: "/about", label: "About me" }}
>
  {
    years.map((year) => (
      <section
        class="grid grid-cols-[minmax(0,1fr)_minmax(0,5fr)] gap-10 border-t border-muted pt-8 pb-16 phone:grid-cols-1 phone:gap-4 phone:pb-8"
        aria-labelledby={`year-${year}`}
      >
        <h2
          id={`year-${year}`}
          class="font-display text-[clamp(32px,4vw,72px)]/none font-extrabold"
        >
          {year}
        </h2>
        <ol>
          {entries
            .filter((entry) => entry.data.date.startsWith(year))
            .map((entry) => (
              <li>
                <a
                  class="group grid grid-cols-[100px_minmax(0,1fr)] items-baseline gap-7 pt-5 pb-8 phone:grid-cols-1 phone:gap-x-4 phone:gap-y-3"
                  href={entry.url}
                >
                  <time
                    class="text-[13px] text-ink-muted"
                    datetime={entry.data.date}
                  >
                    {formatEntryDate(entry.data.date)}
                  </time>
                  <div>
                    <h3 class="font-serif text-[clamp(28px,3vw,48px)]/[1.2] wrap-anywhere group-hover:underline group-hover:decoration-1 group-focus-visible:underline group-focus-visible:decoration-1">
                      {entry.data.title}
                    </h3>
                    {entry.data.keywords.length > 0 && (
                      <p class="mt-3 text-[max(16px,1.1vw)] text-ink-muted">
                        {entry.data.keywords.join(" / ")}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            ))}
        </ol>
      </section>
    ))
  }
  {
    entries.length === 0 && (
      <p>
        Nothing here yet.{" "}
        <a class="underline" href="/">
          Back home
        </a>
        .
      </p>
    )
  }
</ArchivePage>
