---
import CollectionIndexShell from "../../components/CollectionIndexShell.astro";
import SelectableRow from "../../components/SelectableRow.astro";
import Layout from "../../layouts/Layout.astro";
import { getExperiments } from "../../lib/content/experiments";

const experiments = await getExperiments();
---

<Layout title="Tristan Kennedy | Experiments">
  <CollectionIndexShell
    title="Experiments"
    backHref="/"
    backLabel="BACK"
    count={experiments.length}
    countLabel="RANDOM IDEAS"
  >
    {
      experiments.map((experiment, index) => (
        <SelectableRow
          href={experiment.url}
          index={index + 1}
          title={experiment.data.title}
          description={experiment.data.description}
          date={experiment.data.date}
          meta={experiment.data.tech}
          metaType="tags"
        />
      ))
    }
  </CollectionIndexShell>
</Layout>
