---
import Layout from "../../layouts/Layout.astro";
import SlugHero from "../../components/SlugHero.astro";
import { render } from "astro:content";
import { getExperiments } from "../../lib/content/experiments";

export async function getStaticPaths() {
  const experiments = await getExperiments();
  return experiments.map((experiment) => ({
    params: { slug: experiment.id },
    props: { experiment },
  }));
}

const { experiment } = Astro.props;
const { Content } = await render(experiment);
---

<Layout title={experiment.data.title}>
  <SlugHero
    title={experiment.data.title}
    image={experiment.data.image}
    description={experiment.data.description}
    backHref="/experiments"
    backLabel="EXPERIMENTS"
    typeLabel="Experiment"
    date={experiment.data.date}
    metaLabel="STACK"
    metaValue={experiment.data.tech.join(" / ")}
    linkHref={experiment.data.link}
  />

  <article class="mdx max-w-[720px] pb-16 md:pb-24">
    <Content />
  </article>
</Layout>
