---
import CollectionIndexShell from "../../components/CollectionIndexShell.astro";
import SelectableRow from "../../components/SelectableRow.astro";
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/content/posts";

const posts = await getPosts();
---

<Layout title="Tristan Kennedy | Posts">
  <CollectionIndexShell
    title="Posts"
    backHref="/"
    backLabel="BACK"
    count={posts.length}
    countLabel="CONTENT PIECES"
  >
    {
      posts.map((post, index) => (
        <div data-reveal="row" data-reveal-direction="left">
          <SelectableRow
            href={post.url}
            index={index + 1}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            meta={post.data.length}
            metaType="text"
          />
        </div>
      ))
    }
  </CollectionIndexShell>
</Layout>
