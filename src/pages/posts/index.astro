---
import CollectionIndexShell from "../../components/CollectionIndexShell.astro";
import SelectableRow from "../../components/SelectableRow.astro";
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/content/posts";

const posts = await getPosts();
---

<Layout title="Tristan Kennedy | Posts">
  <CollectionIndexShell
    title="Posts"
    backHref="/"
    backLabel="BACK"
    breadcrumb="INDEX / POSTS"
    count={posts.length}
    countLabel="POSTS"
  >
    {
      posts.map((post, index) => (
        <SelectableRow
          href={post.url}
          index={index + 1}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          meta={post.data.length}
          metaType="text"
        />
      ))
    }
  </CollectionIndexShell>
</Layout>
